# Frontend Environment Variables Template
# Copy this file to .env and fill in your values

# ===========================================
# Supabase Configuration
# ===========================================
# Get these from Supabase > Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# Backend API URL (IMPORTANT FOR PRODUCTION)
# ===========================================
# For LOCAL development: Leave as http://localhost:5000
# For PRODUCTION (Vercel): Set to your Render backend URL
#
# Example production URL:
# VITE_API_URL=https://your-backend-service.onrender.com
#
# NOTE: If VITE_API_URL is not set, the app will attempt to detect
# the production environment and use the deployed backend URL automatically.
VITE_API_URL=http://localhost:5000

# ===========================================
# Optional: Explicit Production Backend URL
# ===========================================
# Use this if you want to explicitly set a different backend URL
# for production environments. This takes precedence over auto-detection.
VITE_DEPLOYED_BACKEND_URL=https://backend-api-end.onrender.com
